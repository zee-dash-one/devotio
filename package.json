{
  "name": "devotio-monorepo",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "graphify": "node scripts/graphify.mjs",
    "graphify:code": "node scripts/graphify.mjs extract . --code-only --no-gitignore --no-cluster",
    "dev": "npm run dev --workspace=web",
    "setup:local": "node scripts/prepare-local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:web": "npm run build && node scripts/verify-web-build.mjs",
    "deploy:web": "npm run build:ready && npm run deploy:web:built",
    "build:ready": "npm run lint && npm run typecheck && npm run verify:web",
    "deploy:backend": "convex dev --once --typecheck enable",
    "deploy:backend:prod": "convex deploy --typecheck enable",
    "deploy:web:built": "npm run deploy --workspace=web --",
    "deploy:web:preview": "npm run deploy:preview --workspace=web --",
    "deploy:pilot": "npm run build:ready && npm run deploy:backend && npm run deploy:web:built"
  },
  "devDependencies": {
    "convex": "^1.46.0",
    "wrangler": "^4.42.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "globals": "^16.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
